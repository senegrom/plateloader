# Allow accessing .html files without the extension (e.g. /app/plateloader → plateloader.html)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /app/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>

# CSP for app pages — fonts and JS are now local; everything stays same-origin.
# 'unsafe-inline' for style-src is needed for inline <style> in plateloader.html.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'; upgrade-insecure-requests"
</IfModule>

# Ensure manifest.json is served correctly
<Files "manifest.json">
  Header always set Content-Type "application/manifest+json"
</Files>

# Service worker scope cookie (so /app/sw.js can claim /app/)
<Files "sw.js">
  Header always set Service-Worker-Allowed "/app/"
</Files>

# Disable mod_pagespeed for /app/ — it rewrites icon URLs with hashes
# (xfoo.png.pagespeed.ic.HASH.png) which breaks SW precache of original
# paths. The app is already well-optimised: woff2 fonts, brotli, small
# PNGs. PageSpeed adds nothing here and breaks PWA offline.
<IfModule pagespeed_module>
  ModPagespeed unplugged
</IfModule>

# Override server-default long max-age on HTML/JS/JSON. The default
# (~22 months) means browsers don't refetch and never see new code.
# Service worker still provides offline capability via its own cache.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|json|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # sw.js especially must not be cached — it's the update mechanism.
  <Files "sw.js">
    Header set Cache-Control "no-store, must-revalidate"
  </Files>
</IfModule>
